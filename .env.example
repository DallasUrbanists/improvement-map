# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Cloud API
# Optional API origin override. Leave blank to use the production Cloud API URL.
VITE_API_BASE_URL=
VITE_API_KEY=your_backend_api_key_here

# Set to true to enable the accountless TV, presenter remote, and audience routes.
# Development builds are enabled by default when this value is omitted.
VITE_PRESENTATION_ENABLED=false

# Opt in to authenticated presentation WebSocket state delivery. The backend
# must also enable PRESENTATION_ENABLED and PRESENTATION_WEBSOCKET_ENABLED.
# Only the exact value "true" enables socket probes; otherwise HTTP sync remains active.
VITE_PRESENTATION_WEBSOCKET_ENABLED=false

# Firebase + RECAPTCHA API Key
VITE_FIREBASE_API_KEY=your_key_here
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=your_token_here
VITE_RECAPTCHA_SITE_KEY=your_key_here
