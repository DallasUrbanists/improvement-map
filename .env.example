# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Cloud API
# Optional outside staging. Staging requires the receipt origin; never leave blank.
VITE_API_BASE_URL=
VITE_API_KEY=your_backend_api_key_here

# Set to true to enable the accountless TV, presenter remote, and audience routes.
# Development builds are enabled by default when this value is omitted.
VITE_PRESENTATION_ENABLED=false

# Opt in to authenticated presentation WebSocket state delivery. The backend
# must also enable PRESENTATION_ENABLED and PRESENTATION_WEBSOCKET_ENABLED.
# Only the exact value "true" enables socket probes; otherwise HTTP sync remains active.
VITE_PRESENTATION_WEBSOCKET_ENABLED=false

# Firebase + RECAPTCHA API Key
VITE_FIREBASE_API_KEY=your_key_here
# Local development only. Must be empty for a deployed staging build.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
VITE_RECAPTCHA_SITE_KEY=your_key_here

# Staging build contract: enable explicitly with the actual backend receipt.
# All VITE_* inputs are public browser configuration, never server credentials.
# VITE_DEPLOY_ENV=staging
# BASE_PATH=/
# STAGING_API_ORIGIN=<actual receipt origin>
# VITE_API_BASE_URL=<same actual receipt origin>
# BUILD_COMMIT=<full checked-out frontend commit SHA>
# See docs/deployment/firebase-staging.md for staging-specific GitHub inputs.
