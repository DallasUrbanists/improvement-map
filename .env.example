# Google Maps API Key
# Required APIs in Google Cloud Console:
# 1. Maps JavaScript API (for map rendering & basemaps)
# 2. Places API (for address search autocomplete)
# 3. Geocoding API (for coordinate <-> address conversion)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Cloud API (Optional - defaults to production Cloud Run API)
# VITE_API_BASE_URL=http://localhost:8080
