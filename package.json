{
  "name": "improvement-map",
  "version": "5.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:critical": "playwright test --project=chromium --grep @critical",
    "test:extended": "playwright test --grep-invert @critical",
    "test": "playwright test",
    "major": "npm version major && git push origin main --tags",
    "minor": "npm version minor && git push origin main --tags",
    "patch": "npm version patch && git push origin main --tags",
    "test:ux": "node scripts/test-ux.js",
    "test:ux:full": "node scripts/test-ux.js --full",
    "test:ux:live": "playwright test --config=playwright.ux-live.config.js",
    "test:feature": "node scripts/test-feature.js",
    "test:suite": "node scripts/test-suite.js",
    "start:feature": "node scripts/create-branch.js feature",
    "finish:feature": "node scripts/finish-branch.js feature",
    "finish:refactor": "node scripts/finish-branch.js refactor",
    "start:fix": "node scripts/create-branch.js fix",
    "start:hotfix": "node scripts/create-branch.js hotfix",
    "start:release": "node scripts/create-branch.js release",
    "start:refactor": "node scripts/create-branch.js refactor",
    "start:docs": "node scripts/create-branch.js docs",
    "start:test": "node scripts/create-branch.js test",
    "start:chore": "node scripts/create-branch.js chore"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/turf": "^7.2.0",
    "dayjs": "^1.11.23",
    "firebase": "^13.0.0",
    "konsta": "^5.4.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
