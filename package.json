{
  "name": "improvement-map",
  "version": "5.4.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "docker compose up --no-build --pull never",
    "status": "node scripts/dev-status.js",
    "dev:provider": "vite",
    "preview": "vite preview",
    "branch:start": "node scripts/create-branch.js",
    "branch:finish": "node scripts/finish-branch.js",
    "release": "node scripts/release.js",
    "preversion": "node scripts/assert-main.js",
    "playwright:install": "node scripts/playwright-task.js install",
    "test:ux:live": "playwright test --config=playwright.ux-live.config.js",

    "dev:local": "vite --mode sandbox",

    "storybook": "storybook dev -p 6006 --no-open",

    "mock:dev": "node scripts/local-development/mock-server.js",
    "mock:reset": "node scripts/local-development/reset.js",

    "test": "playwright test",
    "test:local": "node --test tests/local-development.node.mjs && playwright test --config playwright.local.config.js",
    "test:storybook": "node scripts/playwright-task.js storybook",
    "test:storybook:watch": "node scripts/playwright-task.js storybook-watch",
    "test:feature": "node scripts/test-feature.js",
    "test:unit": "playwright test --project=unit",
    "test:suite": "node scripts/test-suite.js",
    "test:critical": "playwright test --project=chromium --grep @critical",
    "test:ux": "node scripts/test-ux.js",
    "test:storybook:visual": "playwright test --config playwright.storybook.config.js",
    "test:storybook:pages": "node scripts/test-storybook-pages.js",
    "test:staging": "node --test tests/staging.node.mjs tests/release.node.mjs",
    "storybook:select": "node scripts/storybook-selection.js",
    "build": "vite build",
    "build:storybook": "storybook build --disable-telemetry",
    "build:pages": "node scripts/build-pages.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@storybook/cli": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@turf/turf": "^7.2.0",
    "dayjs": "^1.11.23",
    "firebase": "^13.0.0",
    "konsta": "^5.4.0",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/roboto": "5.3.0",
    "@playwright/test": "^1.50.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-mcp": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/vue3-vite": "10.6.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "15.34.1",
    "postcss": "^8.5.3",
    "storybook": "10.6.3",
    "storybook-addon-pseudo-states": "10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "4.1.12",
    "workbox-window": "^7.3.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
