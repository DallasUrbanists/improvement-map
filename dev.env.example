# Optional: copy to .env.development.local. No file is needed for mocks.
# DEV_MAPS_MODE=live
# VITE_GOOGLE_MAPS_API_KEY=your-local-development-browser-key

# Every selector defaults to mock:
# DEV_OVERPASS_MODE=mock
# DEV_API_MODE=mock
# DEV_UPLOADS_MODE=mock
# DEV_ASSIST_MODE=mock
# DEV_STREETMIX_MODE=mock
# DEV_PRESENTATION_MODE=mock
# DEV_AUTH_MODE=mock
# DEV_APPCHECK_MODE=mock
# DEV_GEOLOCATION_MODE=mock
# DEV_SPEECH_MODE=mock
# DEV_MEDIA_MODE=mock

# Live Cloud API groups require explicit staging configuration and CORS/App Check:
# DEV_LIVE_API_ORIGIN=https://your-approved-staging-origin.example
# VITE_API_KEY=your-staging-browser-api-key
# VITE_FIREBASE_API_KEY=your-firebase-browser-key
# VITE_RECAPTCHA_SITE_KEY=your-authorized-development-site-key
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=your-authorized-local-debug-token
